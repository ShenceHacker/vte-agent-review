# Reference only: export these in your shell; the program does not load .env files.
VTE_BASE_URL=https://api.openai.com/v1
VTE_API_KEY=
VTE_MODEL=
# Select chat_completions or responses (must support function calls and vision).
VTE_API_STYLE=chat_completions
# Optional reasoning/output settings. Responses uses streaming transport.
# VTE_REASONING_EFFORT=low
# VTE_MAX_OUTPUT_TOKENS=6000
# VTE_CALL_TIMEOUT=240
# Optional per-role overrides, otherwise VTE_MODEL is used.
# VTE_MODEL_A=
# VTE_MODEL_B=
# VTE_MODEL_C=
# VTE_MODEL_D=
